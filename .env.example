# AfriBench — Variables d'environnement
# Copiez ce fichier en .env ou exportez chaque variable dans votre shell.
# Toutes les clés sont optionnelles — seuls les modèles utilisés nécessitent leur clé.

# Clé pour protéger POST /api/v1/evaluate et /reload (backend)
# Laissez vide pour désactiver les endpoints d'écriture.
# Ne déployez jamais la valeur d'exemple : elle est publique.
# AFRIBENCH_API_KEY=

# Origines autorisées (CORS), séparées par des virgules. Défaut : "*".
# À restreindre dès qu'un mot de passe admin ou une clé API est défini.
# AFRIBENCH_CORS_ORIGINS=https://ytilikan.github.io

# Nombre de proxys de confiance devant l'API (défaut : 0).
# À 0, X-Forwarded-For est ignoré : l'en-tête est fourni par le client, donc le
# faire tourner suffirait à contourner tout rate limiting.
# Derrière un proxy (Railway, nginx, Cloudflare), mettez 1 — sinon tous les
# visiteurs partagent un même compteur et se bloquent mutuellement.
# AFRIBENCH_TRUSTED_PROXY_HOPS=1

# Rate limits — requêtes par fenêtre glissante, par IP et par chemin
# AFRIBENCH_RATE_LIMIT_READ=120
# AFRIBENCH_RATE_LIMIT_READ_WINDOW=60
# AFRIBENCH_RATE_LIMIT_WRITE=10
# AFRIBENCH_RATE_LIMIT_WRITE_WINDOW=60
# Limite dédiée au login backoffice (anti-dictionnaire)
# AFRIBENCH_RATE_LIMIT_LOGIN=5
# AFRIBENCH_RATE_LIMIT_LOGIN_WINDOW=900

# Durée de vie d'une session backoffice, en secondes (défaut : 43200 = 12 h)
# AFRIBENCH_ADMIN_SESSION_TTL=43200

# PostgreSQL (jobs, rate-limit, questions/résultats — recommandé en prod)
# Exemple local : postgresql://afribench:afribench@localhost:5432/afribench
# Schéma géré par Alembic (migrations auto au démarrage du backend).
# Base existante créée via create_all ? : cd backend && alembic stamp 001_baseline && alembic upgrade head
# AFRIBENCH_DATABASE_URL=

# Redis optionnel (rate-limit distribué ; prioritaire sur Postgres si défini)
# AFRIBENCH_REDIS_URL=redis://localhost:6379/0

# Backend rate-limit : auto | memory | postgres | redis (défaut : auto)
# AFRIBENCH_RATE_LIMIT_BACKEND=auto

# Clé Fernet pour chiffrer les clés API modèles en base (générer avec Fernet.generate_key())
# AFRIBENCH_ENCRYPTION_KEY=

# Mot de passe backoffice admin
# AFRIBENCH_ADMIN_PASSWORD=

# OpenAI (GPT-4o, GPT-4o-mini)
OPENAI_API_KEY=sk-...

# Anthropic (Claude Sonnet 4, Claude Haiku 3.5)
ANTHROPIC_API_KEY=sk-ant-...

# Mistral AI (Mistral Large)
MISTRAL_API_KEY=...

# Google Gemini
GEMINI_API_KEY=...

# DeepSeek
DEEPSEEK_API_KEY=...

# Together AI (Llama, open models)
TOGETHER_API_KEY=...
